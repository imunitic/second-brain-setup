      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Three lanes: what the MODEL judges, what a SCRIPT executes, what lands in the VAULT.\nArrows cross from the model lane into the script lane in exactly two places \u2014 the seam.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Three lanes: what the MODEL judges, what a SCRIPT executes, what lands in the VAULT.\nArrows cross from the model lane into the script lane in exactly two places \u2014 the seam.",
      "lineHeight": 1.25
    },
