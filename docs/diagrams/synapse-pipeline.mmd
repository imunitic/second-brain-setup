---
title: Synapse — how the pieces fit
---
%% Colour carries the lane: what the MODEL judges, what a SCRIPT executes, what
%% lands in the VAULT. Subgraphs carry the phase. The seam is visible as the only
%% two arrows that leave a yellow box for a blue one -- manifest.tsv and b-NN.md.
%% --
%% Boxes carry NAMES, not descriptions. What each one actually does lives in the
%% reference table under this diagram in docs/synapse-graph.md. A box holding four
%% lines of mechanism is a paragraph in a rectangle: it cannot be read at a glance,
%% which is the only thing a diagram is better at than prose. Keep labels to a name
%% plus at most a three-word role, and put the detail in the table.
flowchart TB
    classDef model fill:#ffec99,stroke:#e8590c,color:#1e1e1e
    classDef seam fill:#ffc9c9,stroke:#c2255c,color:#1e1e1e,stroke-width:3px
    classDef script fill:#d0ebff,stroke:#1971c2,color:#1e1e1e
    classDef vault fill:#d3f9d8,stroke:#2f9e44,color:#1e1e1e
    classDef hook fill:#ffd8a8,stroke:#e8590c,color:#1e1e1e
    classDef cmd fill:#e5dbff,stroke:#6741d9,color:#1e1e1e

    subgraph BUILD["BUILD · /synapse-init"]
        direction TB
        ORIENT["<b>model</b><br/>orient and cluster"]
        MANIFEST["<b>manifest.tsv</b><br/>THE SEAM"]
        LISTS["synapse-build-lists.sh<br/>enumerate and expand"]
        PROSE["<b>model</b><br/>author node prose"]
        PUSH["synapse-push-nodes.sh"]
        WRITE["synapse-write-node.sh<br/>hash, slice, write"]
        IDX["synapse-build-index.sh"]
        PIDX["synapse-build-project-index.sh"]
        TAGS["synapse-tags.sh<br/><i>optional</i>"]

        TAGS -.->|"clustering signal"| ORIENT
        ORIENT -->|"authors"| MANIFEST
        MANIFEST --> LISTS
        MANIFEST --> PROSE
        LISTS -->|"path lists"| PUSH
        PROSE -->|"bodies"| PUSH
        PUSH -->|"per node"| WRITE
        WRITE --> IDX --> PIDX
    end

    subgraph VAULT["VAULT · synapse/{repo}@{branch}/"]
        direction LR
        NODE["{Node Title}.md × N"]
        JSON["_index.json"]
        INDEX["Index.md"]
        AUX["_manifest.tsv · _profile.txt"]
        TAGSCACHE["_tags_cache.json"]
    end

    WRITE ==>|"REST PUT"| NODE
    IDX ==> JSON
    PIDX ==> INDEX
    WRITE -.->|"byproduct"| TAGSCACHE

    subgraph USE["READ · DETECT · REPAIR"]
        direction TB
        QUERY["synapse-query.sh<br/>body · sources · field"]
        SYMBOL["synapse-query.sh symbol"]
        NODESKILL["synapse-node skill<br/>Tier 2"]
        STALE1["synapse-staleness.sh<br/>Tier 1"]
        STALE2["synapse-query.sh stale"]
        DRIFT["synapse-query.sh drift"]
        GROUND["synapse-query.sh grounding"]
        REBUILD["/synapse-rebuild"]
        CLEAN["synapse-graph-clean.sh"]

        DRIFT --> REBUILD
        GROUND --> REBUILD
    end

    NODE -.->|"read"| QUERY
    NODE -.-> NODESKILL
    JSON -.-> STALE1
    NODE -.-> STALE2
    NODE -.-> DRIFT
    NODE -.-> GROUND
    NODE -.->|"sources"| SYMBOL
    TAGSCACHE -.->|"read"| SYMBOL
    SYMBOL -.->|"backfill"| TAGSCACHE
    REBUILD ==>|"re-writes nodes"| WRITE
    CLEAN -.->|"deletes namespace"| NODE

    class ORIENT,PROSE model
    class MANIFEST seam
    class LISTS,PUSH,WRITE,IDX,PIDX,TAGS,QUERY,SYMBOL,STALE2,DRIFT,GROUND,CLEAN script
    class NODE,JSON,INDEX,AUX,TAGSCACHE vault
    class STALE1 hook
    class REBUILD,NODESKILL cmd

    subgraph KEY["the colours"]
        direction LR
        K1["model judgment"]
        K2["the seam"]
        K3["script — mechanics"]
        K4["vault artifact"]
        K5["fires automatically"]
        K6["command / skill"]
    end
    class K1 model
    class K2 seam
    class K3 script
    class K4 vault
    class K5 hook
    class K6 cmd

    %% Neutral subgraph fills: the default pale yellow competes with the model
    %% lane's own yellow, and the point of the palette is that the lane is
    %% readable at a glance.
    style BUILD fill:#ffffff,stroke:#adb5bd,stroke-dasharray:4 4
    style VAULT fill:#ffffff,stroke:#adb5bd,stroke-dasharray:4 4
    style USE fill:#ffffff,stroke:#adb5bd,stroke-dasharray:4 4
    style KEY fill:#ffffff,stroke:#adb5bd,stroke-dasharray:4 4
