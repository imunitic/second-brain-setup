#!/bin/bash
# Switch the active second-brain backend (org-roam <-> obsidian).
# Usage: second-brain-switch <org-roam|obsidian>
set -euo pipefail

CONF="$HOME/.claude/second-brain.conf"
NEW="${1:-}"

case "$NEW" in
  org-roam|obsidian) ;;
  *)
    echo "Usage: second-brain-switch <org-roam|obsidian>" >&2
    exit 1
    ;;
esac

if [ ! -f "$CONF" ]; then
  echo "Config file not found: $CONF" >&2
  exit 1
fi

sed -i '' "s/^BACKEND=.*/BACKEND=$NEW/" "$CONF"
echo "Second-brain backend switched to: $NEW"
echo "(takes effect on the next hook firing / session start -- no restart needed)"
